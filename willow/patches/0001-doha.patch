+	}
+	if ((held = MiniIOSurfaceCopy(s->sid)) == NULL) {
+		return false;
+	}
+	MiniIOSurfaceDisplayUse(held, 1);
+	fMdss[VIG0_STRIDE] = s->info.bytesPerRow;
+	fMdss[VIG0_ADDR] = (uint32_t) phys;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fMdss[CTL0_FLUSH] = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
