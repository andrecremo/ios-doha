+/* (the driver's warnings and errors are said whatever happens to the rest) */
+static void
+driver_complains(const char *kind, const char *format, va_list list)
+{
+	char line[320];
+
+	vsnprintf(line, sizeof(line), format, list);
+	lx_tell("ath10k %s: %s%s", kind, line, line[0] != 0 && line[strlen(line) - 1] == '\n' ? "" : "\n");
+}
+
+void
+ath10k_warn(struct ath10k *ar, const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	driver_complains("WARNS", format, list);
+	va_end(list);
+	/*
+	 * (doha) HTC's "ready" not come: copy engines 0 (control out) and 2 (control in) as they are now, before the driver takes
+	 * them down -- ring addresses and sizes, write indices, current read indices (wcn3990: ce n at membase + 0x240000 +
+	 * 0x1000 n; sr_base 0x0, sr_size 0x8, dr_base 0xc, dr_size 0x14, sr_wr 0x3c, dst_wr 0x40, srri 0x44, drri 0x48)
+	 */
+	for (const char *f = format; *f != 0; f++) {
+		if (memcmp(f, "control response", 16) == 0) {
+			{
+				char shown[64];
+
+				snprintf(shown, sizeof(shown), "w sh%lu-%lu wr%lu-%lu ce%lu-%lu ot%lu-%lu %x=%x", lx_snoc_writes[0],
+				    lx_snoc_dropped[0], lx_snoc_writes[1], lx_snoc_dropped[1], lx_snoc_writes[2], lx_snoc_dropped[2],
+				    lx_snoc_writes[3], lx_snoc_dropped[3], lx_snoc_last_offset[3], lx_snoc_last_value[3]);
+				lx_os_status(shown);
+			}
+			{
+				char shown[64];
+
+				/* CE2 (HTC's control, in): misc status (errors: 0x100 AXI, 0x200 dest address, 0x80 max length,
+				 * 0x40 overflow), its watermark/copy status, ctrl1, the ring's high address bits; CE1 misc too */
+				snprintf(shown, sizeof(shown), "ce2 mis%x drri%x ce1 mis%x pool %llx", ath10k_snoc_read32(ar, 0x242038),
+				    ath10k_snoc_read32(ar, 0x242048), ath10k_snoc_read32(ar, 0x241038), lx_os_radio_physical());
+				lx_os_status(shown);
+				lx_tell("lx: %s\n", shown);
+			}
+			lx_tell("lx: writes sh %lu-%lu wr %lu-%lu ce %lu-%lu ot %lu-%lu; last sh %x=%x wr %x=%x ot %x=%x\n",
+			    lx_snoc_writes[0], lx_snoc_dropped[0], lx_snoc_writes[1], lx_snoc_dropped[1], lx_snoc_writes[2],
+			    lx_snoc_dropped[2], lx_snoc_writes[3], lx_snoc_dropped[3], lx_snoc_last_offset[0], lx_snoc_last_value[0],
+			    lx_snoc_last_offset[1], lx_snoc_last_value[1], lx_snoc_last_offset[3], lx_snoc_last_value[3]);
+			lx_tell("lx: CE0 sr %x/%x wr %x srri %x; CE2 dr %x/%x wr %x drri %x; CE1 dr %x/%x wr %x drri %x\n",
+			    ath10k_snoc_read32(ar, 0x240000), ath10k_snoc_read32(ar, 0x240008), ath10k_snoc_read32(ar, 0x24003c),
+			    ath10k_snoc_read32(ar, 0x240044), ath10k_snoc_read32(ar, 0x24200c), ath10k_snoc_read32(ar, 0x242014),
+			    ath10k_snoc_read32(ar, 0x242040), ath10k_snoc_read32(ar, 0x242048), ath10k_snoc_read32(ar, 0x24100c),
+			    ath10k_snoc_read32(ar, 0x241014), ath10k_snoc_read32(ar, 0x241040), ath10k_snoc_read32(ar, 0x241048));
+			{
+				struct ath10k_ce *ce = ath10k_ce_priv(ar);
+				struct ath10k_ce_ring *r = ce->ce_states[2].dest_ring;
+
+				if (r != NULL && r->base_addr_owner_space != NULL) {
+					struct ce_desc_64 *d = r->base_addr_owner_space;
+					struct sk_buff *skb = r->per_transfer_context[0];
+					const uint8_t *b = skb != NULL ? skb->data : NULL;
+
+					lx_tell("lx: CE2 ring sw %u wr %u; desc0 addr %llx nbytes %u flags %x; desc1 nbytes %u; "
+					    "buffer0 %02x%02x%02x%02x %02x%02x%02x%02x %02x%02x%02x%02x\n", r->sw_index, r->write_index,
+					    (unsigned long long)d[0].addr, d[0].nbytes, d[0].flags, d[1].nbytes,
+					    b ? b[0] : 0, b ? b[1] : 0, b ? b[2] : 0, b ? b[3] : 0, b ? b[4] : 0, b ? b[5] : 0,
+					    b ? b[6] : 0, b ? b[7] : 0, b ? b[8] : 0, b ? b[9] : 0, b ? b[10] : 0, b ? b[11] : 0);
+				}
+			}
+			break;
+		}
+	}
+}
