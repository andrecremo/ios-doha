+			return false;
+		}
+		fFlipHomeAddr = fMdss[VIG0_ADDR];
+		fFlipHomeStride = fMdss[VIG0_STRIDE];
+		IOLog("MiniIOMobileFramebuffer: fb_flip=1: VIG0 shows %#x (stride %u); frames will be shown where drawn\n",
+		    fFlipHomeAddr, fFlipHomeStride);
