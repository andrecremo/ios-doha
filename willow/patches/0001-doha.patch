diff --git a/wifi/lx/src10/lx_snoc.c b/wifi/lx/src10/lx_snoc.c
new file mode 100755
index 0000000..f85c3c2
--- /dev/null
+++ b/wifi/lx/src10/lx_snoc.c
@@ -0,0 +1,877 @@
+/*
+ * The radio's bus on miatoll: ath10k's own (snoc.c, compiled here as part of this file, unmodified) on a device that the
+ * device tree would have described -- its registers, its twelve interrupts, its properties -- and the entries the kernel
+ * calls (lx_start() and the rest of bsd/sys/redwood_lx.h). What the platform bus does under Linux is done here in its
+ * order: the device made, the driver's probe called on it, its removal called on the way out.
+ *
+ * The radio is a WCN3990 (Redmi Note 9S, SM7125; Linux: sc7180.dtsi, wifi@18800000):
+ *   membase   0x0C800000, 8 MB: the copy engines' registers
+ *   CE 0..11  SPIs 414..425: not taken; a thread of ours looks at the copy engines once a millisecond while the driver
+ *             has them on (the driver's interrupts, enabled or not, are noted and nothing else), as the POCO's bus did
+ *             first (wifi/lx/src/lx_bus.c)
+ *   MSA       the firmware's memory, which the modem's driver has already given it (drivers/modem/redwood.mpss.c, WLFW):
+ *             "qcom,msa-fixed-perm", and no reserved region, so that nothing here ever maps or assigns it
+ * The firmware is the modem's, up and ready before lx_start() is called; the driver's QMI client (qmi.c) hears that in
+ * the answer to its first request and goes straight on to the driver's registration (snoc.c: ath10k_snoc_fw_indication()).
+ * The rails and the reference clock are the boot chain's and the modem's, and on: the driver's regulators and clocks
+ * are empty (wifi/lx/include/linux/regulator/consumer.h, linux/clk.h).
+ *
+ * Frames: in "Ethernet" frame mode the firmware puts the kernel's frames into 802.11 itself (mac.c: TX encapsulation
+ * offload); what it receives the driver hands up as 802.11, which lx_80211.c makes Ethernet of (to_ethernet()).
+ */
+#define LX_QMI_AS_IT_IS				/* (this file is where the driver's requests go past) */
+#include <linux/kernel.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+/* what snoc.c asks of its device that the device tree would have answered, and Linux 7.0 has and LinuxKPI not */
+#define device_get_match_data(dev)	((const void *)&drv_priv)
+#define netif_threaded_enable(dev)	((void)0)
+int device_property_read_u32(struct device *dev, const char *name, u32 *value);
+void *devm_memremap(struct device *dev, resource_size_t offset, size_t size, unsigned long flags);
+
+/*
+ * doha: with ath10k the modem's Wi-Fi domain goes down during HTC's wait; with our own WLFW client's configuration and
+ * mission mode alone it stays up. wifi_ce_nowrite=1: every register write of the bus's (the copy engines', their
+ * wrapper's) is left out -- the rest of the driver as it is -- to see whether those writes are what the firmware dies of
+ */
+unsigned lx_os_option(const char *name);
+void lx_os_print(const char *text);
+void lx_os_status(const char *text);
+unsigned long long lx_os_radio_physical(void);
+/*
+ * With every write left out the domain stayed up: which ones it dies of, by region of the radio's registers.
+ * wifi_ce_nowrite=1: none written; 2: the shadow registers' (0x30000..0x3ffff) left out; 3: the engines' wrapper's
+ * (0x24c000 on); 4: the engines' own (0x240000..0x24bfff); 5: everything outside those three. The writes of each region are
+ * counted (lx_snoc_writes), shown when HTC's wait fails
+ */
+static int lx_nowrite = -1;
+static char *lx_snoc_mem;
+static unsigned long lx_snoc_writes[4], lx_snoc_dropped[4];   /* shadow, wrapper, engines, other */
+static u32 lx_snoc_last_offset[4], lx_snoc_last_value[4];
+
+static inline void __iomem *
+lx_snoc_ioremap(struct device *dev, resource_size_t offset, resource_size_t size)
+{
+	void __iomem *mapped = devm_ioremap(dev, offset, size);
+
+	if (lx_snoc_mem == NULL) {
+		lx_snoc_mem = (char *)mapped;
+	}
+	return mapped;
+}
+#define devm_ioremap(d, o, s)	lx_snoc_ioremap((d), (o), (s))
+
+static inline void
+lx_snoc_iowrite32(u32 value, void *address)
+{
+	unsigned long offset = lx_snoc_mem != NULL ? (unsigned long)((char *)address - lx_snoc_mem) : ~0ul;
+	int region = offset >= 0x30000 && offset < 0x40000 ? 0 : offset >= 0x24c000 && offset < 0x800000 ? 1 :
+	    offset >= 0x240000 && offset < 0x24c000 ? 2 : 3;
+
+	if (lx_nowrite < 0) {
+		lx_nowrite = (int)lx_os_option("wifi_ce_nowrite");
+	}
+	lx_snoc_writes[region]++;
+	lx_snoc_last_offset[region] = (u32)offset;
+	lx_snoc_last_value[region] = value;
+	if (lx_nowrite == 1 || (lx_nowrite >= 2 && lx_nowrite <= 5 && region == lx_nowrite - 2)) {
+		lx_snoc_dropped[region]++;
+		return;
+	}
+	iowrite32(value, address);
+}
+#define iowrite32(v, a)	lx_snoc_iowrite32((v), (a))
+
+#include "snoc.c"
+#undef iowrite32
+#undef devm_ioremap
+
+#include <lx_os.h>
+#include "lx.h"
+
+#define LX_IRQ		400		/* the numbers the copy engines' interrupts are given (they are no GIC's) */
+
+static struct {
+	struct ath10k *ar;
+	struct napi_struct *napi;
+	volatile bool napi_on;		/* between the driver's napi_enable() and napi_disable() */
+	volatile bool polling;		/* the thread is in the driver right now */
+	volatile bool looking;		/* the thread is wanted ... */
+	volatile bool looks;		/* ... and runs */
+	volatile bool gone;		/* the radio's firmware has stopped (lx_os_radio_gone()): its registers are not touched again */
+	bool irq_mode;			/* the copy engines' interrupts are taken (wifi_irq): NAPI runs when one has come, as on Linux */
+	volatile bool napi_wanted;	/* ... and it has been scheduled (napi_schedule()) */
+	unsigned long long polls, busy;	/* looks at the copy engines, and of them those that found work */
+	struct {
+		irq_handler_t handler;
+		void *argument;
+		bool enabled;
+	} irq[CE_COUNT_MAX];
+} bus;
