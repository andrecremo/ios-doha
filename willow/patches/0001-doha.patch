+	}
+	ext.leaf_at = ~0ull;
+	ext.on = true;
+	printf("mss: %u: ext4: %u-byte blocks, %u inodes a group of %u bytes, descriptors of %u\n", step, ext.block,
+	    ext.inodes_per_group, ext.inode_size, ext.desc_size);
+	return true;
