+	__asm__ volatile ("dsb sy" ::: "memory");
+	flipLatched();
+	MiniIOSurfaceDisplayUse(fFlipped, -1);
+	MiniIOSurfaceDrop(fFlipped);
+	fFlipped = NULL;
+}
