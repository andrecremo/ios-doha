+/* A region of the firmware's memory given to the modem's MSA and the WLAN's VM through TrustZone (MP_ASSIGN) */
+static bool
+wlfw2_assign(uint64_t address, uint32_t bytes)
+{
+	vm_offset_t page = 0;
+	uint64_t *ext, answer = 0, base;
+	int32_t result;
