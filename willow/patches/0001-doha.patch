+	phys = s->memory->getPhysicalSegment((IOByteCount) (s->pixels() - s->kbase), &length, kIOMemoryMapperNone);
+	if (phys == 0 || length < bytes || phys + bytes > 0x100000000ull) {
+		fFlipMisses++;
+		return false;
+	}
