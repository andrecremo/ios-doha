+/* The inode of `name` in directory `dir`; 0 if it is not there */
+static uint32_t
+ext_find(uint32_t dir, const char *name)
+{
+	uint8_t inode[160], *buffer;
+	uint64_t size, at;
+	uint32_t found = 0;
+	size_t want = strlen(name);
+
+	if (!ext_inode(dir, inode) || (size = ext_size(inode)) == 0 || size > (16u << 20) ||
