+/* Boot 2 stopped after initCPU with no "came alive" and no 5 s panic. Show
+ * why, then spin 1 s on the raw counter: needs no timer interrupt. */
+static void
+doha_dump(const char *where)
+{
+	uint32_t g[5];
+	doha_gic_regs(g);
+	kprintf("DOHA %s irq t=%u s=%u o=%u sp=%u last=%u IE=%u\n", where,
+	    doha_irq_counts[0], doha_irq_counts[1], doha_irq_counts[2], doha_irq_counts[3],
+	    doha_irq_last, ml_get_interrupts_enabled());
+	kprintf("DOHA ICC pmr=%llx rpr=%llx grp1=%llx hppi=%llx isr=%llx daif=%llx\n",
+	    __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_RPR_EL1"),
+	    __builtin_arm_rsr64("ICC_IGRPEN1_EL1"), __builtin_arm_rsr64("ICC_HPPIR1_EL1"),
+	    __builtin_arm_rsr64("ISR_EL1"), __builtin_arm_rsr64("DAIF"));
+	kprintf("DOHA CNTV ctl=%llx cval=%llx vct=%llx\n",
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_CVAL_EL0"),
+	    __builtin_arm_rsr64("CNTVCT_EL0"));
+	kprintf("DOHA GIC ctlr=%x waker=%x en=%x pend=%x act=%x\n", g[0], g[1], g[2], g[3], g[4]);
+	uint64_t end = __builtin_arm_rsr64("CNTVCT_EL0") + __builtin_arm_rsr64("CNTFRQ_EL0");
+	while (__builtin_arm_rsr64("CNTVCT_EL0") < end) {
+		__builtin_arm_isb(ISB_SY);
+	}
+}
+#endif
