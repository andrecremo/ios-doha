+/*
+ * DOHA internal eMMC: sdhci@4744000 (qcom,sdhci-msm-v5), read-only BSD disk.
+ *
+ * The sequence was proven on the phone by shim/sdhci.c (NOTES.md, boots 5-10).
+ * ABL leaves the host reset: set the GCC root clock to 400 kHz, power the bus
+ * with the MSM power-switch acknowledgement, select 1.8 V pads, identify the
+ * card, then go to 8-bit HS at 50 MHz. Data moves by polled ADMA2 through one
+ * physically contiguous allocation (descriptors and a 1 MiB bounce buffer);
+ * the host is not treated as cache coherent, so caches are maintained around
+ * each transfer. The block device glue follows ios-sweet's sweet_ufs.c.
+ *
+ * It finds one GPT partition by name (boot-arg emmcroot=, default "userdata")
+ * and exposes it as the BSD disk emmcroot0 (remmcroot0). Root on it with
+ * rd=emmcroot0. Boot-arg emmcprobe=1 times the first 16 MiB of boot_a.
+ *
+ * READ ONLY: no data write path exists. The only commands sent are CMD0, CMD1,
+ * CMD2, CMD3 and CMD7 (reset and select the card), CMD13 (status), CMD8 (read
+ * EXT_CSD), CMD18 (read blocks, with auto CMD12) and CMD6, only for the two mode
+ * fields BUS_WIDTH and HS_TIMING of EXT_CSD. No CMD24, CMD25. Opening for writing
+ * fails with EROFS.
+ */
+#if defined(ARM64_BOARD_CONFIG_DOHA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define HC_PA                   0x04744000UL
+#define HC_SIZE                 0x1000
+#define HC_BLOCK                0x04    /* size (16), count (16) */
+#define HC_ARG                  0x08
+#define HC_XFER_CMD             0x0c    /* transfer mode (16), command (16) */
+#define HC_RESP0                0x10
+#define HC_DATA                 0x20
+#define HC_PRESENT              0x24
+#define HC_CTRL1                0x28
+#define HC_POWER                0x29
+#define HC_CLOCK                0x2c    /* clock (16), timeout (8), software reset (8) */
+#define HC_TIMEOUT              0x2e
+#define HC_RESET                0x2f
+#define HC_INT                  0x30    /* normal (16), error (16); write 1 to clear */
+#define HC_INT_EN               0x34
+#define HC_SIG_EN               0x38
+#define HC_CTRL2_HI             0x3e
+#define HC_ADMA_ERR             0x54
+#define HC_ADMA_ADDR            0x58
+#define HC_ADMA_ADDR_HI         0x5c
+#define HC_VERSION              0xfe
+
+/* sdhci_msm_v5_offset */
+#define MSM_DLL_CONFIG          0x200
+#define DLL_PDN                 (1u << 29)
+#define DLL_RST                 (1u << 30)
+#define MSM_VENDOR_SPEC         0x20c
+#define MSM_PWRCTL_STATUS       0x240
+#define MSM_PWRCTL_CLEAR        0x248
+#define MSM_PWRCTL_CTL          0x24c
+#define PWRCTL_BUS_SUCCESS      (1u << 0)
+#define PWRCTL_IO_SUCCESS       (1u << 2)
+#define VENDOR_IO_PAD_EN        (1u << 15)
+#define VENDOR_IO_PAD_1V8       (1u << 16)
+
+/* gcc-sm6125: gcc_sdcc1_apps_clk_src and branches, in one 4 KiB page */
+#define GCC_SDCC1_PA            0x01438000UL
+#define GCC_SDCC1_SIZE          0x1000
+#define GCC_APPS_CBCR           0x004
+#define GCC_AHB_CBCR            0x008
+#define GCC_RCG_CMD             0x028
+#define GCC_RCG_CFG             0x02c
+#define GCC_RCG_M               0x030
+#define GCC_RCG_N               0x034
+#define GCC_RCG_D               0x038
+#define CBCR_OFF                (1u << 31)
+#define RCG_UPDATE              (1u << 0)
+#define RCG_CFG_400K            ((23u << 0) | (0u << 8) | (2u << 12))   /* TCXO / 12, M/N 1/4 */
+#define RCG_CFG_50M             ((11u << 0) | (2u << 8))                /* GPLL0_OUT_AUX2 / 6 */
+
+#define PRESENT_INHIBIT         0x3     /* command and data lines */
+#define CLOCK_SD_ON             (1u << 2)
+#define POWER_ON_3V0            0x0d    /* bus on, 3.0 V: vdd is 2.95 V */
+#define CTRL2_1V8               (1u << 3)
+#define CTRL1_HS                (1u << 2)
+#define CTRL1_DMA_MASK          (3u << 3)
+#define CTRL1_ADMA2_32          (2u << 3)
+#define CTRL1_8BIT              (1u << 5)
+#define RESET_CMD_DAT           0x6
+#define INT_CMD                 (1u << 0)
+#define INT_XFER                (1u << 1)
+#define INT_BUF_RD              (1u << 5)
+#define INT_ERR                 (1u << 15)
+
+/* Command register: index << 8 | data present | index check | CRC check | response */
+#define CMD_NONE                0x00
+#define CMD_R1                  0x1a
+#define CMD_R1B                 0x1b
+#define CMD_R1_DATA             0x3a
+#define CMD_R2                  0x09
+#define CMD_R3                  0x02
+#define XFER_READ_ONE_PIO       ((1u << 4) | (1u << 1))  /* card to host, count enable, no DMA */
+/* DMA on, count enable, auto CMD12 (Linux MULTIBLOCK_READ_ACMD12), read, multi-block */
+#define XFER_READ_DMA           ((1u << 0) | (1u << 1) | (1u << 2) | (1u << 4) | (1u << 5))
+#define ADMA_VALID_TRAN         0x21
+#define ADMA_END                0x02
+#define ADMA_CHUNK              0x8000u
+
+#define MMC_GO_IDLE             0
+#define MMC_SEND_OP_COND        1
+#define MMC_ALL_SEND_CID        2
+#define MMC_SET_RCA             3
+#define MMC_SWITCH              6
+#define MMC_SELECT              7
+#define MMC_READ_EXT_CSD        8
+#define MMC_STATUS              13
+#define MMC_READ_MULTIPLE       18
+#define MMC_STATE_TRAN          4
+#define OCR_SECTOR_DUAL         0x40ff8080      /* sector addressing, 1.8 V and 2.7-3.6 V */
+#define OCR_READY               (1u << 31)
+#define CARD_RCA                1
+#define R1_SWITCH_ERROR         (1u << 7)
+
+#define EXT_CSD_PART_CONFIG     179
+#define EXT_CSD_BUS_WIDTH       183
+#define EXT_CSD_HS_TIMING       185
+#define EXT_CSD_DEVICE_TYPE     196
+#define EXT_CSD_SEC_COUNT       212
+#define BUS_WIDTH_8             2
+#define HS_TIMING_HS            1
+#define DEVICE_TYPE_HS_52       (1u << 1)
+
+#define SECTOR                  512u
+#define BOUNCE_SIZE             (1u << 20)
+#define BOUNCE_SECTORS          (BOUNCE_SIZE / SECTOR)
+#define PHYS_BLOCK              4096u
+#define GPT_ENTRY_SIZE          128u
+#define GPT_MAX_ENTRIES         128u
+#define TIMEOUT_NS              (1000ull * NSEC_PER_MSEC)
+#define TIMEOUT_DMA_NS          (5000ull * NSEC_PER_MSEC)
+#define PROBE_BYTES             (16u << 20)
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_DESC                0x0000
+#define DMA_BOUNCE              0x4000
+#define DMA_SIZE                (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t hc, gcc;
+	vm_offset_t dma;                /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint32_t ext_csd[SECTOR / 4];
+	uint32_t last_int;
+	uint64_t first_lba, nsectors;   /* partition, in 512-byte sectors */
+	uint32_t secsize;               /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool host_up, ready;
+} em;
+
+static LCK_GRP_DECLARE(doha_emmc_grp, "doha_emmc");
+static LCK_MTX_DECLARE(doha_emmc_lock, &doha_emmc_grp);
+
+static inline uint32_t
+rd32(unsigned r)
+{
+	return *(volatile uint32_t *)(em.hc + r);
+}
+
+static inline uint16_t
+rd16(unsigned r)
+{
+	return *(volatile uint16_t *)(em.hc + r);
+}
+
+static inline uint8_t
+rd8(unsigned r)
+{
+	return *(volatile uint8_t *)(em.hc + r);
+}
+
+static inline void
+wr32(unsigned r, uint32_t v)
+{
+	*(volatile uint32_t *)(em.hc + r) = v;
+}
+
+static inline void
+wr16(unsigned r, uint16_t v)
+{
+	*(volatile uint16_t *)(em.hc + r) = v;
+}
+
+static inline void
+wr8(unsigned r, uint8_t v)
+{
+	*(volatile uint8_t *)(em.hc + r) = v;
+}
+
+static inline uint32_t
+gcc_rd(unsigned r)
+{
+	return *(volatile uint32_t *)(em.gcc + r);
+}
+
+static inline void
+gcc_wr(unsigned r, uint32_t v)
+{
+	*(volatile uint32_t *)(em.gcc + r) = v;
+}
+
+static uint64_t
+deadline_ns(uint64_t ns)
+{
+	uint64_t t;
+
+	nanoseconds_to_absolutetime(ns, &t);
+	return mach_absolute_time() + t;
+}
+
+static uint8_t
+ext_csd_byte(unsigned off)
+{
+	return ((const uint8_t *)em.ext_csd)[off];
+}
+
+static void
+reset_lines(void)
+{
+	uint64_t end = deadline_ns(TIMEOUT_NS);
+
+	wr8(HC_RESET, RESET_CMD_DAT);
+	while ((rd8(HC_RESET) & RESET_CMD_DAT) && mach_absolute_time() < end) {
+		;
+	}
+	wr32(HC_INT, 0xffffffff);
+}
+
+/* 0 when a bit of mask latched (and acked); EIO on a controller error, ETIMEDOUT otherwise. */
+static int
+wait_int(uint32_t mask, uint64_t timeout_ns)
+{
+	uint64_t end = deadline_ns(timeout_ns);
+
+	for (;;) {
+		uint32_t st = rd32(HC_INT);
+		if (st & INT_ERR) {
+			em.last_int = st;
+			reset_lines();
+			return EIO;
+		}
+		if (st & mask) {
+			wr32(HC_INT, st & mask);
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			em.last_int = st;
+			reset_lines();
+			return ETIMEDOUT;
+		}
+	}
+}
+
+static int
+wait_idle(void)
+{
+	uint64_t end = deadline_ns(TIMEOUT_NS);
+
+	while (rd32(HC_PRESENT) & PRESENT_INHIBIT) {
+		if (mach_absolute_time() > end) {
+			em.last_int = rd32(HC_PRESENT);
+			reset_lines();
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+static int
+send_cmd(unsigned index, uint32_t arg, unsigned flags, uint32_t xfer)
+{
+	int rc = wait_idle();
+
+	if (rc) {
+		return rc;
+	}
+	wr32(HC_INT, 0xffffffff);
+	if (xfer) {
+		wr32(HC_BLOCK, (1u << 16) | SECTOR);
+	}
+	wr32(HC_ARG, arg);
+	wr32(HC_XFER_CMD, ((index << 8 | flags) << 16) | xfer);
+	return wait_int(INT_CMD, TIMEOUT_NS);
+}
+
+/* EXT_CSD by PIO into em.ext_csd, before the fast path exists. */
+static int
+read_ext_csd(void)
+{
+	int rc = send_cmd(MMC_READ_EXT_CSD, 0, CMD_R1_DATA, XFER_READ_ONE_PIO);
+
+	if (rc) {
+		return rc;
+	}
+	rc = wait_int(INT_BUF_RD, TIMEOUT_NS);
+	if (rc) {
+		return rc;
+	}
+	for (unsigned i = 0; i < SECTOR / 4; i++) {
+		em.ext_csd[i] = rd32(HC_DATA);
+	}
+	return wait_int(INT_XFER, TIMEOUT_NS);
+}
+
+static int
+report_fail(const char *what, int rc)
+{
+	printf("DOHA EMMC: %s failed: %d int=0x%x\n", what, rc, em.last_int);
+	return rc;
+}
+
+/* Sectors from the whole device into the bounce buffer; caller holds the lock. */
+static int
+emmc_read(uint64_t lba, uint32_t sectors)
+{
+	uint32_t *desc = (uint32_t *)(em.dma + DMA_DESC);
+	uint32_t bytes = sectors * SECTOR, chunks = (bytes + ADMA_CHUNK - 1) / ADMA_CHUNK;
+	uint64_t bounce_pa = em.dma_pa + DMA_BOUNCE;
+	uint64_t cards = (uint64_t)em.ext_csd[EXT_CSD_SEC_COUNT / 4];
+
+	if (sectors == 0 || sectors > BOUNCE_SECTORS || lba + sectors > cards) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < chunks; i++) {
+		uint32_t len = (i == chunks - 1) ? bytes - i * ADMA_CHUNK : ADMA_CHUNK;
+
+		desc[2 * i] = (len << 16) | ADMA_VALID_TRAN | (i == chunks - 1 ? ADMA_END : 0);
+		desc[2 * i + 1] = (uint32_t)(bounce_pa + i * ADMA_CHUNK);
+	}
+	clean_dcache64((addr64_t)(em.dma_pa + DMA_DESC), chunks * 8, TRUE);
+	/* Nothing dirty may be evicted over the data the host is about to write. */
+	flush_dcache64((addr64_t)bounce_pa, bytes, TRUE);
+
+	int rc = wait_idle();
+	if (rc) {
+		return rc;
+	}
+	wr32(HC_INT, 0xffffffff);
+	/* The host advances this register as it walks the table: set it every time. */
+	wr32(HC_ADMA_ADDR, (uint32_t)(em.dma_pa + DMA_DESC));
+	wr32(HC_ADMA_ADDR_HI, 0);
+	wr32(HC_BLOCK, (sectors << 16) | SECTOR);
+	wr32(HC_ARG, (uint32_t)lba);
+	__builtin_arm_dsb(0xf);         /* SY: descriptors are visible before the command */
+	wr32(HC_XFER_CMD, ((MMC_READ_MULTIPLE << 8 | CMD_R1_DATA) << 16) | XFER_READ_DMA);
+	rc = wait_int(INT_CMD, TIMEOUT_NS);
+	if (!rc) {
+		rc = wait_int(INT_XFER, TIMEOUT_DMA_NS);
+	}
+	if (rc) {
+		printf("DOHA EMMC: read lba %llu n %u failed: %d int=0x%x adma=0x%x\n",
+		    lba, sectors, rc, em.last_int, rd32(HC_ADMA_ERR));
+		return rc;
+	}
+	/* Drop any line the CPU pulled in speculatively during the transfer. */
+	flush_dcache64((addr64_t)bounce_pa, bytes, TRUE);
+	return 0;
+}
+
+static int
+rcg_update(void)
+{
+	uint64_t end = deadline_ns(100 * NSEC_PER_MSEC);
+
+	gcc_wr(GCC_RCG_CMD, gcc_rd(GCC_RCG_CMD) | RCG_UPDATE);
+	while (gcc_rd(GCC_RCG_CMD) & RCG_UPDATE) {
+		if (mach_absolute_time() > end) {
+			printf("DOHA EMMC: RCG stuck, cmd=0x%x\n", gcc_rd(GCC_RCG_CMD));
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+/* Linux sdhci_msm_handle_pwr_irq, polled: clear the request and report success. */
+static void
+ack_power(uint32_t ack)
+{
+	uint64_t end = deadline_ns(100 * NSEC_PER_MSEC);
+	uint32_t st;
+
+	while (!(st = rd32(MSM_PWRCTL_STATUS)) && mach_absolute_time() < end) {
+		;
+	}
+	if (st) {
+		wr32(MSM_PWRCTL_CLEAR, st);
+		wr32(MSM_PWRCTL_CTL, ack);
+	}
+}
+
+static int
+host_init(void)
+{
+	/* The SD clock is off while the root clock changes. */
+	wr16(HC_CLOCK, rd16(HC_CLOCK) & (uint16_t)~CLOCK_SD_ON);
+	gcc_wr(GCC_RCG_M, (gcc_rd(GCC_RCG_M) & ~0xffu) | 1);
+	gcc_wr(GCC_RCG_N, (gcc_rd(GCC_RCG_N) & ~0xffu) | (~(4u - 1) & 0xff));
+	gcc_wr(GCC_RCG_D, (gcc_rd(GCC_RCG_D) & ~0xffu) | (~4u & 0xff));
+	gcc_wr(GCC_RCG_CFG, RCG_CFG_400K);
+	int rc = rcg_update();
+	if (rc) {
+		return rc;
+	}
+	for (unsigned r = GCC_APPS_CBCR; r <= GCC_AHB_CBCR; r += 4) {
+		if (gcc_rd(r) & CBCR_OFF) {
+			gcc_wr(r, gcc_rd(r) | 1);
+		}
+	}
+	delay(1000);
+
+	/* Status bits must be enabled to latch; the signal lines stay off (no IRQs). */
+	wr32(HC_SIG_EN, 0);
+	wr32(HC_INT_EN, 0xffffffff);
+	wr32(MSM_VENDOR_SPEC, rd32(MSM_VENDOR_SPEC) | VENDOR_IO_PAD_EN | VENDOR_IO_PAD_1V8);
+
+	wr8(HC_POWER, POWER_ON_3V0);
+	ack_power(PWRCTL_BUS_SUCCESS | PWRCTL_IO_SUCCESS);
+	wr16(HC_CTRL2_HI, CTRL2_1V8);
+	ack_power(PWRCTL_IO_SUCCESS);
+
+	wr8(HC_TIMEOUT, 0xe);
+	wr16(HC_CLOCK, rd16(HC_CLOCK) | CLOCK_SD_ON);
+	delay(2000);    /* at least 74 clocks before the first command */
+	return 0;
+}
+
+static int
+card_init(void)
+{
+	uint32_t ocr = 0;
+	int rc;
+
+	/* No response expected. Back to the power-on default: 1-bit, slow. */
+	rc = send_cmd(MMC_GO_IDLE, 0, CMD_NONE, 0);
+	if (rc) {
+		return report_fail("CMD0", rc);
+	}
+	delay(2000);
+
+	for (unsigned tries = 0; tries < 200 && !(ocr & OCR_READY); tries++) {
+		rc = send_cmd(MMC_SEND_OP_COND, OCR_SECTOR_DUAL, CMD_R3, 0);
+		if (rc) {
+			return report_fail("CMD1", rc);
+		}
+		ocr = rd32(HC_RESP0);
+		delay(10000);
+	}
+	if (!(ocr & OCR_READY)) {
+		printf("DOHA EMMC: card not ready, OCR 0x%x\n", ocr);
+		return ETIMEDOUT;
+	}
+
+	/* The CID carries the serial number: read it, do not print it. */
+	rc = send_cmd(MMC_ALL_SEND_CID, 0, CMD_R2, 0);
+	if (rc) {
+		return report_fail("CMD2", rc);
+	}
+	rc = send_cmd(MMC_SET_RCA, CARD_RCA << 16, CMD_R1, 0);
+	if (rc) {
+		return report_fail("CMD3", rc);
+	}
+	rc = send_cmd(MMC_SELECT, CARD_RCA << 16, CMD_R1B, 0);
+	if (rc) {
+		return report_fail("CMD7", rc);
+	}
+	rc = send_cmd(MMC_STATUS, CARD_RCA << 16, CMD_R1, 0);
+	if (rc) {
+		return report_fail("CMD13", rc);
+	}
+	uint32_t r1 = rd32(HC_RESP0);
+	if (((r1 >> 9) & 0xf) != MMC_STATE_TRAN) {
+		printf("DOHA EMMC: card not in tran state, r1=0x%x\n", r1);
+		return EIO;
+	}
+	return 0;
+}
+
+/* CMD6, write-byte access to one EXT_CSD mode field; R1b, so wait out the busy. */
+static int
+mmc_switch(unsigned index, unsigned value)
+{
+	int rc = send_cmd(MMC_SWITCH, (3u << 24) | (index << 16) | (value << 8), CMD_R1B, 0);
+
+	if (rc) {
+		return report_fail("CMD6", rc);
+	}
+	rc = wait_idle();
+	if (rc) {
+		return report_fail("CMD6 busy", rc);
+	}
+	rc = send_cmd(MMC_STATUS, CARD_RCA << 16, CMD_R1, 0);
+	if (rc) {
+		return report_fail("CMD6 status", rc);
+	}
+	uint32_t r1 = rd32(HC_RESP0);
+	if (r1 & R1_SWITCH_ERROR) {
+		printf("DOHA EMMC: CMD6 field %u refused, r1=0x%x\n", index, r1);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+go_fast(void)
+{
+	int rc = read_ext_csd();
+
+	if (rc) {
+		return report_fail("EXT_CSD", rc);
+	}
+	if (ext_csd_byte(EXT_CSD_PART_CONFIG) & 7) {
+		printf("DOHA EMMC: not on the user area\n");
+		return EIO;
+	}
+	if (!(ext_csd_byte(EXT_CSD_DEVICE_TYPE) & DEVICE_TYPE_HS_52)) {
+		printf("DOHA EMMC: no HS52, type=0x%x\n", ext_csd_byte(EXT_CSD_DEVICE_TYPE));
+		return ENOTSUP;
+	}
+
+	rc = mmc_switch(EXT_CSD_BUS_WIDTH, BUS_WIDTH_8);
+	if (rc) {
+		return rc;
+	}
+	wr8(HC_CTRL1, rd8(HC_CTRL1) | CTRL1_8BIT);
+	rc = read_ext_csd();
+	if (rc) {
+		return report_fail("8-bit read", rc);
+	}
+
+	rc = mmc_switch(EXT_CSD_HS_TIMING, HS_TIMING_HS);
+	if (rc) {
+		return rc;
+	}
+	wr8(HC_CTRL1, rd8(HC_CTRL1) | CTRL1_HS);
+
+	/* DLL off below 100 MHz (Linux sdhci_msm_set_uhs_signaling). */
+	wr16(HC_CLOCK, rd16(HC_CLOCK) & (uint16_t)~CLOCK_SD_ON);
+	wr32(MSM_DLL_CONFIG, rd32(MSM_DLL_CONFIG) | DLL_RST);
+	wr32(MSM_DLL_CONFIG, rd32(MSM_DLL_CONFIG) | DLL_PDN);
+	gcc_wr(GCC_RCG_CFG, RCG_CFG_50M);
+	rc = rcg_update();
+	if (rc) {
+		return rc;
+	}
+	wr16(HC_CLOCK, rd16(HC_CLOCK) | CLOCK_SD_ON);
+	delay(1000);
+
+	rc = read_ext_csd();
+	if (rc) {
+		return report_fail("HS read", rc);
+	}
+	printf("DOHA EMMC: 8-bit HS 50 MHz, %u sectors, width=%u hs=%u\n",
+	    em.ext_csd[EXT_CSD_SEC_COUNT / 4], ext_csd_byte(EXT_CSD_BUS_WIDTH),
+	    ext_csd_byte(EXT_CSD_HS_TIMING));
+
+	wr8(HC_CTRL1, (rd8(HC_CTRL1) & (uint8_t)~CTRL1_DMA_MASK) | CTRL1_ADMA2_32);
+	return 0;
+}
+
+/* Bounds of a GPT partition, in sectors; caller holds the lock. */
+static int
+find_partition(const char *want, uint64_t *first, uint64_t *count)
+{
+	const uint8_t *b = (const uint8_t *)(em.dma + DMA_BOUNCE);
+	int rc = emmc_read(1, 1);
+
+	if (rc) {
+		return rc;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("DOHA EMMC: no GPT at LBA 1\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != GPT_ENTRY_SIZE || nent == 0 || nent > GPT_MAX_ENTRIES) {
+		printf("DOHA EMMC: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	rc = emmc_read(entry_lba, (nent * esz + SECTOR - 1) / SECTOR);
+	if (rc) {
+		return rc;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t lo, hi;
+		memcpy(&lo, e + 32, 8);
+		memcpy(&hi, e + 40, 8);
+		if (hi < lo) {
+			return ENXIO;
+		}
+		*first = lo;
+		*count = hi - lo + 1;
+		printf("DOHA EMMC: p%u %s LBA %llu..%llu\n", i + 1, name, lo, hi);
+		return 0;
+	}
+	printf("DOHA EMMC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+/* Host, card and the DMA memory, once; caller holds the lock. */
+static int
+host_up(void)
+{
+	if (em.host_up) {
+		return 0;
+	}
+	em.hc = ml_io_map(HC_PA, HC_SIZE);
+	em.gcc = ml_io_map(GCC_SDCC1_PA, GCC_SDCC1_SIZE);
+	if (!em.hc || !em.gcc) {
+		printf("DOHA EMMC: cannot map registers\n");
+		return ENXIO;
+	}
+	if (kmem_alloc_contig(kernel_map, &em.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("DOHA EMMC: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)em.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	em.dma_pa = ptoa_64(pn);
+	/* ADMA2 descriptors here are 32-bit. */
+	if (em.dma_pa + DMA_SIZE > (1ull << 32)) {
+		printf("DOHA EMMC: DMA memory at 0x%llx is above 4 GiB\n", em.dma_pa);
+		return ENXIO;
+	}
+	printf("DOHA EMMC: read only; ver=0x%x, DMA at 0x%llx\n", rd16(HC_VERSION), em.dma_pa);
+
+	int rc = host_init();
+	if (!rc) {
+		rc = card_init();
+	}
+	if (!rc) {
+		rc = go_fast();
+	}
+	if (!rc) {
+		em.host_up = true;
+	}
+	return rc;
+}
+
+static int
+doha_emmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!em.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+doha_emmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+doha_emmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * em.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = em.nsectors * SECTOR;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&doha_emmc_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % SECTOR);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t sectors = (skip + want + SECTOR - 1) / SECTOR;
+
+		error = emmc_read(em.first_lba + pos / SECTOR, sectors);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const char *)(em.dma + DMA_BOUNCE) + skip, want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&doha_emmc_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+doha_emmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = em.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > PHYS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		em.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = SECTOR;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = em.nsectors * SECTOR / em.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / em.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+doha_emmc_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return doha_emmc_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+doha_emmc_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return doha_emmc_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+doha_emmc_psize(__unused dev_t dev)
+{
+	return em.ready ? (int)MIN(em.nsectors * SECTOR / em.secsize, INT_MAX) : -1;
+}
+
+static int
+doha_emmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(doha_emmc_strategy, NULL, dev, B_READ, minphys, uio, (int)em.secsize);
+}
+
+static int
+doha_emmc_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw doha_emmc_bdevsw = {
+	.d_open     = doha_emmc_open,
+	.d_close    = doha_emmc_close,
+	.d_strategy = doha_emmc_strategy,
+	.d_ioctl    = doha_emmc_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = doha_emmc_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw doha_emmc_cdevsw = {
+	.d_open       = doha_emmc_open,
+	.d_close      = doha_emmc_close,
+	.d_read       = doha_emmc_read,
+	.d_write      = doha_emmc_write,
+	.d_ioctl      = doha_emmc_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+doha_emmc_init(void)
+{
+	char want[64] = "userdata";
+	int error;
+
+	PE_parse_boot_argn("emmcroot", want, sizeof(want));
+	lck_mtx_lock(&doha_emmc_lock);
+	error = host_up();
+	if (!error) {
+		error = find_partition(want, &em.first_lba, &em.nsectors);
+	}
+	lck_mtx_unlock(&doha_emmc_lock);
+	if (error) {
+		return error;
+	}
+
+	em.secsize = DEV_BSIZE;
+	em.bmajor = bdevsw_add(-1, &doha_emmc_bdevsw);
+	if (em.bmajor < 0) {
+		return ENXIO;
+	}
+	em.cmajor = cdevsw_add_with_bdev(-1, &doha_emmc_cdevsw, em.bmajor);
+	if (em.cmajor < 0) {
+		return ENXIO;
+	}
+	em.bdev = makedev(em.bmajor, 0);
+	devfs_make_node(em.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
+	devfs_make_node(makedev(em.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "remmcroot0");
+	em.ready = true;
+	printf("DOHA EMMC: \"%s\" is emmcroot0, %llu MiB, read-only\n", want, em.nsectors / 2048);
+	return 0;
+}
+
+/* boot-arg emmcprobe=1: the first 16 MiB of boot_a, to compare with a backup. */
+void doha_emmc_probe(void);
+void
+doha_emmc_probe(void)
+{
+	uint64_t first = 0, count = 0, ns;
+	uint32_t sum = 0;
+
+	lck_mtx_lock(&doha_emmc_lock);
+	int rc = host_up();
+	if (!rc) {
+		rc = find_partition("boot_a", &first, &count);
+	}
+	uint64_t start = mach_absolute_time(), busy = 0;
+	for (uint32_t s = 0; !rc && s < PROBE_BYTES / SECTOR; s += BOUNCE_SECTORS) {
+		uint64_t t = mach_absolute_time();
+		rc = emmc_read(first + s, BOUNCE_SECTORS);
+		busy += mach_absolute_time() - t;
+		const uint32_t *w = (const uint32_t *)(em.dma + DMA_BOUNCE);
+		for (uint32_t i = 0; !rc && i < BOUNCE_SIZE / 4; i++) {
+			sum += w[i];
+		}
+	}
+	lck_mtx_unlock(&doha_emmc_lock);
+	if (rc) {
+		printf("DOHA EMMC: probe failed: %d\n", rc);
+		return;
+	}
+	absolutetime_to_nanoseconds(busy, &ns);
+	printf("DOHA EMMC: 16 MiB of boot_a: %llu ms in reads, sum32 0x%x\n", ns / NSEC_PER_MSEC, sum);
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	printf("DOHA EMMC: with the sum, %llu ms\n", ns / NSEC_PER_MSEC);
+}
+
+/* Root device for rd=emmcroot0 (IOFindBSDRoot). */
+int doha_emmc_rootdev(dev_t *dev);
+
+int
+doha_emmc_rootdev(dev_t *dev)
+{
+	if (!em.ready) {
+		int error = doha_emmc_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = em.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_DOHA */
